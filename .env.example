# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=taskdb
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Optional DB_* aliases
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_NAME=taskdb
DB_HOST=db
DB_PORT=5432

# Backend & CORS Configuration
ENVIRONMENT=production
CORS_ORIGINS=https://localhost,http://localhost,https://127.0.0.1,http://127.0.0.1
